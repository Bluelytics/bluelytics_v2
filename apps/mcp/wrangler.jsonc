{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bluelytics-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-22",
  "upload_source_maps": true,
  "workers_dev": false,
  "preview_urls": false,
  // No route of its own: the site's gateway (apps/web, service binding MCP) forwards MCP requests
  // on https://bluelytics.com.ar/mcp here.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bluelytics",
      // Placeholder: `pnpm infra:sync-ids` writes the id of the Pulumi-managed database here.
      "database_id": "ea1ea06c-0f80-4190-80c4-9f86822ceeca",
      "migrations_dir": "../../packages/db/migrations"
    }
  ],
  "observability": { "enabled": true, "head_sampling_rate": 0.2 }
}
