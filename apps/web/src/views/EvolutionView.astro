---
import RangeChart from '../components/RangeChart.astro';
import Base from '../layouts/Base.astro';
import { API_ORIGIN } from '../config.ts';
import { historyPath, ROUTES, type Locale } from '../i18n/routes.ts';
import { pick, UI } from '../i18n/ui.ts';
import { formatPesos, formatSignedPercent } from '../lib/format.ts';
import type { EvolutionData } from '../lib/pages.ts';
import { groupByPeriod, summarize } from '../lib/series.ts';
import { ogVersion } from '../lib/snapshot.ts';

interface Props {
  locale: Locale;
  data: EvolutionData;
}

const { locale, data } = Astro.props;
const { snapshot, series, days } = data;
const t = UI[locale];
const years = groupByPeriod(days, 4)
  .flatMap(({ key, days: list }) => {
    const summary = summarize(list);
    return summary === null ? [] : [{ year: Number(key), summary }];
  })
  .reverse();
const title = pick(locale, 'Evolución del dólar blue y oficial: gráfico histórico | Bluelytics', 'Blue and official dollar evolution: historical chart | Bluelytics');
const description = pick(
  locale,
  'Gráfico de la evolución del dólar blue y del dólar oficial en Argentina desde 2011, con resumen anual y descarga de los datos en CSV y JSON.',
  'Chart of the blue and official dollar in Argentina since 2011, with a yearly summary and the data as CSV and JSON downloads.',
);
---

<Base locale={locale} title={title} description={description} paths={ROUTES.evolution} current="evolution" crumbs={[{ name: t.nav.evolution, path: ROUTES.evolution[locale] }]} dateModified={snapshot.updatedAt} ogVersion={ogVersion(snapshot)}>
  <div class="page-head">
    <h1>{pick(locale, 'Evolución del dólar blue', 'Blue dollar evolution')}</h1>
    <p>{pick(locale, 'Precio de venta al cierre de cada día. Elegí el período o pasá el cursor por el gráfico.', 'Sell price at each day’s close. Pick a range or hover the chart.')}</p>
  </div>
  {
    series.days.length > 1 && (
      <section class="card">
        <RangeChart locale={locale} mode="rates" data={series} presets range="1y" label={pick(locale, 'Dólar blue y oficial, precio de venta', 'Blue and official dollar, sell price')} />
        <p class="dim downloads">
          {pick(locale, 'Descargar todos los datos:', 'Download all data:')} <a href={`${API_ORIGIN}/v2/evolution.csv`}>CSV</a> · <a href={`${API_ORIGIN}/v2/evolution.json`}>JSON</a> · <a href={ROUTES.api[locale]}>API</a>
        </p>
      </section>
    )
  }
  {
    years.length > 0 && (
      <section class="section">
        <h2>{pick(locale, 'Resumen por año (dólar blue, venta)', 'Yearly summary (blue dollar, sell)')}</h2>
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th scope="col">{pick(locale, 'Año', 'Year')}</th>
                <th scope="col" class="num">{pick(locale, 'Apertura', 'Open')}</th>
                <th scope="col" class="num">{pick(locale, 'Cierre', 'Close')}</th>
                <th scope="col" class="num">{pick(locale, 'Mínimo', 'Low')}</th>
                <th scope="col" class="num">{pick(locale, 'Máximo', 'High')}</th>
                <th scope="col" class="num">{pick(locale, 'Variación', 'Change')}</th>
              </tr>
            </thead>
            <tbody>
              {years.map(({ year, summary }) => {
                const open = summary.first.blue?.sell ?? 0;
                const close = summary.last.blue?.sell ?? 0;
                const ratio = open > 0 ? close / open - 1 : 0;
                return (
                  <tr>
                    <th scope="row"><a href={historyPath(locale, { year })}>{year}</a></th>
                    <td class="num">{formatPesos(open, locale)}</td>
                    <td class="num">{formatPesos(close, locale)}</td>
                    <td class="num">{formatPesos(summary.minSell, locale)}</td>
                    <td class="num">{formatPesos(summary.maxSell, locale)}</td>
                    <td class:list={['num', ratio > 0 ? 'up' : ratio < 0 ? 'down' : '']}>{formatSignedPercent(ratio, locale)}</td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      </section>
    )
  }
</Base>
