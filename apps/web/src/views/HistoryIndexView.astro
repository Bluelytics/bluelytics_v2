---
import RangeChart from '../components/RangeChart.astro';
import Base from '../layouts/Base.astro';
import { API_ORIGIN } from '../config.ts';
import { historyPath, historyPaths, ROUTES, type Locale } from '../i18n/routes.ts';
import { pick, UI } from '../i18n/ui.ts';
import { formatDay, formatPesos, formatSignedPercent } from '../lib/format.ts';
import type { HistoryIndexData } from '../lib/history-pages.ts';
import { datasetNode } from '../lib/seo.ts';
import { groupByPeriod, summarize } from '../lib/series.ts';
import { ogVersion } from '../lib/snapshot.ts';

interface Props {
  locale: Locale;
  data: HistoryIndexData;
}

const { locale, data } = Astro.props;
const t = UI[locale];
const { snapshot, series } = data;
const first = data.days[0]?.day;
const last = data.days.at(-1)?.day;
const years = groupByPeriod(data.days, 4)
  .flatMap(({ key, days }) => {
    const summary = summarize(days);
    return summary === null ? [] : [{ year: Number(key), summary }];
  })
  .reverse();
const title = pick(locale, 'Dólar blue histórico desde 2011, día por día | Bluelytics', 'Blue dollar history since 2011, day by day | Bluelytics');
const description = pick(
  locale,
  'Evolución e histórico del dólar blue y oficial en Argentina: gráfico desde 2011, resumen anual, cotización de compra y venta de cada día y descarga de los datos en CSV y JSON.',
  'Evolution and history of the blue and official dollar in Argentina: chart since 2011, yearly summary, buy and sell rates for every day, and the data as CSV and JSON downloads.',
);
---

<Base
  locale={locale}
  title={title}
  description={description}
  paths={historyPaths()}
  current="history"
  crumbs={[{ name: t.nav.history, path: historyPath(locale) }]}
  dateModified={snapshot.updatedAt}
  ogVersion={ogVersion(snapshot)}
  graph={first && last ? [datasetNode(locale, { from: first, to: last })] : []}
>
  <div class="page-head">
    <h1>{pick(locale, 'Dólar blue histórico', 'Blue dollar history')}</h1>
    <p>
      {
        first && last
          ? pick(locale, `Cotizaciones de cada día entre el ${formatDay(first, locale)} y el ${formatDay(last, locale)}. Elegí el período en el gráfico, o un año para ver sus meses y días.`, `Rates for every day from ${formatDay(first, locale)} to ${formatDay(last, locale)}. Pick a range on the chart, or a year to see its months and days.`)
          : t.noData
      }
    </p>
  </div>
  {
    series.days.length > 1 && (
      <section class="card">
        <RangeChart locale={locale} mode="rates" data={series} presets range="1y" label={pick(locale, 'Dólar blue y oficial, precio de venta al cierre de cada día', 'Blue and official dollar, sell price at each day’s close')} />
        <p class="dim downloads">
          {pick(locale, 'Descargar todos los datos:', 'Download all data:')} <a href={`${API_ORIGIN}/v2/evolution.csv`}>CSV</a> · <a href={`${API_ORIGIN}/v2/evolution.json`}>JSON</a> · <a href={ROUTES.api[locale]}>API</a>
        </p>
      </section>
    )
  }
  <section class="section">
    <h2>{pick(locale, 'Resumen por año (dólar blue, venta)', 'Yearly summary (blue dollar, sell)')}</h2>
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th scope="col">{pick(locale, 'Año', 'Year')}</th>
            <th scope="col" class="num">{pick(locale, 'Apertura', 'Open')}</th>
            <th scope="col" class="num">{pick(locale, 'Cierre', 'Close')}</th>
            <th scope="col" class="num">{pick(locale, 'Mínimo', 'Low')}</th>
            <th scope="col" class="num">{pick(locale, 'Máximo', 'High')}</th>
            <th scope="col" class="num">{pick(locale, 'Variación', 'Change')}</th>
          </tr>
        </thead>
        <tbody>
          {years.map(({ year, summary }) => {
            const open = summary.first.blue?.sell ?? 0;
            const close = summary.last.blue?.sell ?? 0;
            const ratio = open > 0 ? close / open - 1 : 0;
            return (
              <tr>
                <th scope="row"><a href={historyPath(locale, { year })}>{year}</a></th>
                <td class="num">{formatPesos(open, locale)}</td>
                <td class="num">{formatPesos(close, locale)}</td>
                <td class="num">{formatPesos(summary.minSell, locale)}</td>
                <td class="num">{formatPesos(summary.maxSell, locale)}</td>
                <td class:list={['num', ratio > 0 ? 'up' : ratio < 0 ? 'down' : '']}>{formatSignedPercent(ratio, locale)}</td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>
  </section>
  <section class="section prose">
    <h2>{pick(locale, 'Sobre estos datos', 'About this data')}</h2>
    <p>
      {
        pick(
          locale,
          'Cada día muestra el último valor publicado por Bluelytics en esa fecha (el cierre). Los datos completos se pueden descargar desde la ',
          'Each day shows the last value Bluelytics published on that date (the close). The whole dataset can be downloaded from the ',
        )
      }
      <a href={ROUTES.api[locale]}>API</a>.
    </p>
  </section>
</Base>
