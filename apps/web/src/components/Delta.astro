---
// Colour is never the only cue: an arrow and a sign go with every move (social-channels-specs §6.4).
// `slab` is the social cards' diagonal-cut block (hero); the default is the compact inline form.
import type { Locale } from '../i18n/routes.ts';
import { formatSignedInteger, formatSignedPercent } from '../lib/format.ts';
import type { Move } from '../lib/series.ts';

interface Props {
  move: Move | null;
  locale: Locale;
  note?: string | undefined;
  slab?: boolean;
}

const { move, locale, note, slab = false } = Astro.props;
---

{
  move && (
    <span class:list={['chip-wrap', { 'slab-wrap': slab }]}>
      <span class:list={[slab ? 'slab' : 'chip', move.direction]}>
        {move.direction === 'up' && (
          <svg viewBox="0 0 10 10" aria-hidden="true">
            <path d="M5 1 9.5 9h-9z" />
          </svg>
        )}
        {move.direction === 'down' && (
          <svg viewBox="0 0 10 10" aria-hidden="true">
            <path d="M5 9 .5 1h9z" />
          </svg>
        )}
        {slab ? (
          <>
            <span class="num">{formatSignedInteger(move.delta, locale)}</span>
            <span class="slab-rule" aria-hidden="true" />
            <span class="num">{formatSignedPercent(move.ratio, locale, 2)}</span>
          </>
        ) : (
          <span class="num">
            {formatSignedInteger(move.delta, locale)} ({formatSignedPercent(move.ratio, locale, 2)})
          </span>
        )}
      </span>
      {note && <span class="chip-note"> {note}</span>}
    </span>
  )
}
