---
import geistUrl from '@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url';
import geistMonoUrl from '@fontsource-variable/geist-mono/files/geist-mono-latin-wght-normal.woff2?url';
import { env } from 'cloudflare:workers';
import Analytics from '../components/Analytics.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { OG_IMAGE_SIZE, SITE_NAME, SOCIAL } from '../config.ts';
import { absoluteUrl, alternates, type Locale, type LocalizedPaths, type RouteId } from '../i18n/routes.ts';
import { breadcrumbNode, jsonLd, ogImageUrl, organizationNode, webPageNode, websiteNode, type Crumb } from '../lib/seo.ts';
import '../styles/global.css';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  paths: LocalizedPaths;
  /** Highlighted header entry. */
  current?: RouteId;
  /** Trail after "Inicio"; also emitted as BreadcrumbList. */
  crumbs?: Crumb[];
  /** Last change of the data shown (UTC). */
  dateModified?: string | null;
  /** Open Graph image version (`null` = unversioned). */
  ogVersion?: string | null;
  /** Extra JSON-LD nodes (WebSite/Organization/WebPage are always present). */
  graph?: Record<string, unknown>[];
  noindex?: boolean;
}

const { locale, title, description, paths, current, crumbs = [], dateModified = null, ogVersion = null, graph = [], noindex = false } = Astro.props;
const path = paths[locale];
const canonical = absoluteUrl(path);
const homeName = locale === 'es' ? 'Inicio' : 'Home';
const trail: Crumb[] = crumbs.length > 0 ? [{ name: homeName, path: locale === 'es' ? '/' : '/en' }, ...crumbs] : [];
const nodes = [
  websiteNode(locale),
  organizationNode(),
  webPageNode({ locale, path, title, description, dateModified }),
  ...(trail.length > 0 ? [breadcrumbNode(trail)] : []),
  ...graph,
];
const ogImage = ogImageUrl(env.MEDIA_ORIGIN, ogVersion);
const ogAlt = locale === 'es' ? 'Cotización del dólar blue hoy en Bluelytics' : 'Blue dollar rate today on Bluelytics';
// Self-hosted Geist / Geist Mono (OFL), Latin subset with the signs the site prints (−, €, arrows).
const RANGE = 'U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+25B2,U+25BC,U+FEFF,U+FFFD';
const fontCss = `@font-face{font-family:'Geist';font-style:normal;font-weight:100 900;font-display:swap;src:url(${geistUrl}) format('woff2');unicode-range:${RANGE}}@font-face{font-family:'Geist Mono';font-style:normal;font-weight:100 900;font-display:swap;src:url(${geistMonoUrl}) format('woff2');unicode-range:${RANGE}}`;
---

<!doctype html>
<html lang={locale === 'es' ? 'es-AR' : 'en'} >
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {alternates(paths).map((alt) => <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />)}
    <meta name="robots" content={noindex ? 'noindex' : 'max-image-preview:large'} />
    <meta name="theme-color" content="#040a14" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/images/mobile-icon-144.png" />
    <link rel="preload" href={geistUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={geistMonoUrl} as="font" type="font/woff2" crossorigin />
    <style is:inline set:html={fontCss}></style>
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={locale === 'es' ? 'es_AR' : 'en_US'} />
    <meta property="og:locale:alternate" content={locale === 'es' ? 'en_US' : 'es_AR'} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content={String(OG_IMAGE_SIZE.width)} />
    <meta property="og:image:height" content={String(OG_IMAGE_SIZE.height)} />
    <meta property="og:image:alt" content={ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={`@${new URL(SOCIAL.x).pathname.slice(1)}`} />
    <meta name="twitter:image:alt" content={ogAlt} />
    <script is:inline type="application/ld+json" set:html={jsonLd(nodes)} />
    <Analytics />
  </head>
  <body>
    <a class="skip" href="#main">{locale === 'es' ? 'Ir al contenido' : 'Skip to content'}</a>
    <Header locale={locale} paths={paths} current={current} />
    <main id="main" class="wrap">
      {
        trail.length > 0 && (
          <ol class="crumbs">
            {trail.map((crumb, i) => <li>{i < trail.length - 1 ? <a href={crumb.path}>{crumb.name}</a> : <span aria-current="page">{crumb.name}</span>}</li>)}
          </ol>
        )
      }
      <slot />
    </main>
    <Footer locale={locale} />
  </body>
</html>
