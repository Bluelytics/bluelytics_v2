---
import { cachePage, LIVE } from '../../lib/cache.ts';
import { loadCurrencies, loadSnapshot } from '../../lib/data.ts';
import CalculatorView from '../../views/CalculatorView.astro';

export const prerender = false;
const [snapshot, currencies] = await Promise.all([loadSnapshot(), loadCurrencies()]);
cachePage(Astro, LIVE, snapshot.updatedAt);
---

<CalculatorView locale="en" snapshot={snapshot} currencies={currencies} />
