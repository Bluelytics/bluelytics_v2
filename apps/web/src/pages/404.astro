---
import { ROUTES } from '../i18n/routes.ts';
import Base from '../layouts/Base.astro';

export const prerender = true;
---

<Base locale="es" title="Página no encontrada | Bluelytics" description="La página que buscás no existe." paths={ROUTES.home} noindex>
  <div class="page-head prose">
    <h1>Página no encontrada</h1>
    <p>La dirección no existe o los datos de esa fecha no están disponibles.</p>
    <p lang="en">This page does not exist, or there is no data for that date.</p>
  </div>
  <p>
    <a class="tool" href={ROUTES.home.es}>Dólar blue hoy</a>
    <a class="tool" href={ROUTES.history.es}>Histórico</a>
    <a class="tool" href={ROUTES.home.en} lang="en">English</a>
  </p>
</Base>
