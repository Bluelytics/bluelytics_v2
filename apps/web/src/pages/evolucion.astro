---
import { cachePage, SLOW } from '../lib/cache.ts';
import { loadEvolution } from '../lib/pages.ts';
import EvolutionView from '../views/EvolutionView.astro';

export const prerender = false;
const data = await loadEvolution();
cachePage(Astro, SLOW, data.snapshot.updatedAt);
---

<EvolutionView locale="es" data={data} />
