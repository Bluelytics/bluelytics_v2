{
  "name": "@bluelytics/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "wrangler types && astro build",
    "preview": "astro preview",
    "check": "astro check",
    "typecheck": "wrangler types && astro check && tsc -p tsconfig.node.json",
    "test": "vitest run",
    "seed:local": "tsx scripts/seed-local.ts",
    "deploy": "wrangler types && astro build && node ../../scripts/wrangler-deploy.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.4.9",
    "@bluelytics/core": "workspace:*",
    "@bluelytics/db": "workspace:*",
    "astro": "7.4.13"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@bluelytics/contract": "workspace:*",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@types/node": "catalog:",
    "miniflare": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
