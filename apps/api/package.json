{
  "name": "@bluelytics/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": "./src/index.ts",
  "scripts": {
    "dev": "wrangler dev --local",
    "deploy": "node ../../scripts/wrangler-deploy.mjs",
    "db:migrate:local": "wrangler d1 migrations apply bluelytics --local",
    "db:migrate:remote": "wrangler d1 migrations apply bluelytics --remote",
    "typecheck": "tsc -p tsconfig.src.json && tsc -p tsconfig.json",
    "test": "vitest run",
    "bench": "tsx bench/cpu.ts"
  },
  "dependencies": {
    "@bluelytics/core": "workspace:*",
    "@bluelytics/db": "workspace:*"
  },
  "devDependencies": {
    "@bluelytics/contract": "workspace:*",
    "@cloudflare/workers-types": "catalog:",
    "@types/node": "catalog:",
    "esbuild": "0.28.2",
    "miniflare": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
